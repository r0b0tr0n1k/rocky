# ── Rocky docker-compose environment ─────────────────────────────
# Copy to `.env` and fill in. Every variable the compose file
# interpolates (${VAR}) is documented here. Defaults are applied in
# compose for the optional overrides, so only DB_HOST/POSTGRES_PASSWORD/
# BETTER_AUTH_SECRET are mandatory for a VM deploy.

# ── Database (EXTERNAL — runs on a separate host/PC) ──
# Point the api at your external Postgres/PostGIS. For single-machine
# local dev, leave DB_HOST=db and start the bundled db with:
#   docker compose --profile local-db up db
DB_HOST=db
DB_PORT=5432
# Db password: used by api (PG_PASS + DATABASE_URL) and by the local
# db service as POSTGRES_PASSWORD. Must match the external DB.
POSTGRES_PASSWORD=change_me_strong_password

# ── Better Auth ──
# Shared by api + web (server-side session validation). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# ── Drizzle Studio (optional `docker compose --profile dev`) ──
DRIZZLE_MASTER_PASS=change_me

# ── Optional VM overrides (defaults shown in compose) ──
# For a VM accessed via browser, point these at the VM host.
# WEB_PUBLIC_API_URL=http://<vm-ip>:8080
# AUTH_BASE_URL=http://<vm-ip>:3000
# CORS_ORIGINS=http://<vm-ip>:3000,http://web:3000
# TRUSTED_ORIGINS=http://<vm-ip>:3000,mobile://
# VERSION=production
# NODE_ENV=production
