# ── Rocky docker-compose environment ─────────────────────────────
# Copy to `.env` and fill in. Every variable the compose file
# interpolates (${VAR}) is documented here. Defaults are applied in
# compose for the optional overrides, so only DB_HOST/POSTGRES_PASSWORD/
# BETTER_AUTH_SECRET/ROCKY_DOMAIN are mandatory for a VM deploy.

# ── Public domain (Cloudflare / DockFlare) ──
# Drives api.<domain> + admin.<domain> and the Access hostnames. Set this
# to your Cloudflare zone domain; compose defaults to example.com.
ROCKY_DOMAIN=example.com

# ── Database (EXTERNAL — runs on a separate host/PC) ──
# Point the api at your external Postgres/PostGIS. For single-machine
# local dev, leave DB_HOST=db and start the bundled db with:
#   docker compose --profile local-db up db
DB_HOST=db
DB_PORT=5432
# Db password: used by api (PG_PASS + DATABASE_URL) and by the local
# db service as POSTGRES_PASSWORD. Must match the external DB.
POSTGRES_PASSWORD=change_me_strong_password

# ── Better Auth ──
# Shared by api + web (server-side session validation). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# ── Cloudflare Access (the "shield") ──
# Web admin: the browser logs into Cloudflare Access (TOTP/2FA, no Google)
# and passes via the CF_Authorization cookie — no code change needed.
# Mobile app: uses a Cloudflare Access SERVICE TOKEN (machine auth) to clear
# the shield without a login. Set these in the MOBILE app env (apps/mob/.env),
# NOT here — they are inlined as EXPO_PUBLIC_* at build time:
#   EXPO_PUBLIC_CF_ACCESS_CLIENT_ID=<cf-service-token-client-id>
#   EXPO_PUBLIC_CF_ACCESS_CLIENT_SECRET=<cf-service-token-secret>
# Create the token in Cloudflare Zero Trust > Access > Service Tokens.
# Then make the api hostname's Access group (rocky-api) allow that token
# (+ authenticated users, so the web browser also reaches api).

# ── Drizzle Studio (optional `docker compose --profile dev`) ──
DRIZZLE_MASTER_PASS=change_me

# ── Optional VM overrides (defaults shown in compose) ──
# These derive from ROCKY_DOMAIN by default; override only if needed.
# WEB_PUBLIC_API_URL=https://api.<domain>
# AUTH_BASE_URL=https://admin.<domain>
# CORS_ORIGINS=https://admin.<domain>
# TRUSTED_ORIGINS=https://admin.<domain>,mobile://
# VERSION=production
# NODE_ENV=production

# ── Notes ──
# - Email suite is OFF (DockFlare `email` profile not enabled).
# - Redis is provided by DockFlare for its own use; Rocky uses Postgres.
# - Published ports are removed; the Cloudflare Tunnel is the only ingress.
# - The `cloudflare-net` network must exist (DockFlare creates it, or run
#     docker network create cloudflare-net
#   and both compose files reference it as external).
