# ── Rocky docker-compose environment ─────────────────────────────
# Copy to `.env` and fill in. This file documents every variable the
# compose file interpolates (${VAR}). Defaults are applied in compose
# for the optional overrides, so only the first three are mandatory.

# ── Database (PostgreSQL + PostGIS) ──
# Single shared secret: the api connects with this (PG_PASS + DATABASE_URL),
# and Postgres uses it (POSTGRES_PASSWORD). Keep them identical.
POSTGRES_PASSWORD=change_me_strong_password

# ── Better Auth ──
# Shared by api + web (server-side session validation). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# ── Drizzle Studio (optional `docker compose --profile dev` only) ──
DRIZZLE_MASTER_PASS=change_me

# ── Optional VM overrides (defaults shown in compose) ──
# When deploying to a VM accessed via browser, point these at the VM host.
# WEB_PUBLIC_API_URL=http://<vm-ip>:8080
# AUTH_BASE_URL=http://<vm-ip>:3000
# CORS_ORIGINS=http://<vm-ip>:3000,http://web:3000
# TRUSTED_ORIGINS=http://<vm-ip>:3000,mobile://
# VERSION=production
# NODE_ENV=production
