{
  "name": "@rocky/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@rocky/execution": "workspace:*"
  },
  "devDependencies": {
    "@rocky/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
