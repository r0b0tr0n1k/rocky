{
  "name": "@rocky/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./zod": "./src/zod/index.ts",
    "./zod/*": "./src/zod/*.ts",
    "./schema/sm": "./src/schema/sm/index.ts",
    "./schema/hk": "./src/schema/hk/index.ts",
    "./schema/an": "./src/schema/an/index.ts",
    "./schema/hd": "./src/schema/hd/index.ts",
    "./schema/events": "./src/schema/events/index.ts",
    "./schema/auth": "./src/schema/auth/index.ts",
    "./schema/demo": "./src/schema/demo/index.ts",
    "./geometry": "./src/geometry/index.ts",
    "./index.js": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/utils": "^0.4.2",
    "@nestjs/common": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "nestjs-cls": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
