{
  "name": "@rocky/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "default": "./dist/constants/*.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "default": "./dist/zod/index.js"
    },
    "./zod/*": {
      "types": "./dist/zod/*.d.ts",
      "default": "./dist/zod/*.js"
    },
    "./schema/sm": {
      "types": "./dist/schema/sm/index.d.ts",
      "default": "./dist/schema/sm/index.js"
    },
    "./schema/hk": {
      "types": "./dist/schema/hk/index.d.ts",
      "default": "./dist/schema/hk/index.js"
    },
    "./schema/an": {
      "types": "./dist/schema/an/index.d.ts",
      "default": "./dist/schema/an/index.js"
    },
    "./schema/hd": {
      "types": "./dist/schema/hd/index.d.ts",
      "default": "./dist/schema/hd/index.js"
    },
    "./schema/events": {
      "types": "./dist/schema/events/index.d.ts",
      "default": "./dist/schema/events/index.js"
    },
    "./schema/auth": {
      "types": "./dist/schema/auth/index.d.ts",
      "default": "./dist/schema/auth/index.js"
    },
    "./schema/demo": {
      "types": "./dist/schema/demo/index.d.ts",
      "default": "./dist/schema/demo/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/utils": "^0.4.2",
    "@nestjs/common": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "nestjs-cls": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
