{
  "name": "@rocky/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./index.js": "./src/index.ts",
    "./*": "./src/*"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/expo": "catalog:",
    "@nestjs/common": "catalog:",
    "@rocky/database": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@rocky/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}
