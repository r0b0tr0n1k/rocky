{
  "name": "@rocky/trpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./superjson": {
      "types": "./dist/superjson.d.ts",
      "default": "./dist/superjson.js"
    },
    "./unwrap": {
      "types": "./dist/unwrap.d.ts",
      "default": "./dist/unwrap.js"
    },
    "./generated": {
      "types": "./dist/generated/server.d.ts",
      "default": "./dist/generated/server.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@rocky/database": "workspace:*",
    "@rocky/domains-shared": "workspace:*",
    "@rocky/execution": "workspace:*",
    "@rocky/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "neverthrow": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@rocky/testing": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  },
  "optionalDependencies": {}
}
