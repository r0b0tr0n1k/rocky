{
  "name": "@rocky/domains-notification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./index.js": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@rocky/database": "workspace:*",
    "@rocky/domains-shared": "workspace:*",
    "@rocky/trpc": "workspace:*",
    "@rocky/validators": "workspace:*",
    "drizzle-orm": "catalog:",
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "optionalDependencies": {}
}
