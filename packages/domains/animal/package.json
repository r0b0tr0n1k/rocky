{
  "name": "@rocky/domains-animal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@rocky/database": "workspace:*",
    "@rocky/domains-system": "workspace:*",
    "@rocky/domains-shared": "workspace:*",
    "@rocky/trpc": "workspace:*",
    "@rocky/validators": "workspace:*",
    "drizzle-orm": "catalog:",
    "neverthrow": "catalog:",
    "@rocky/execution": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "@rocky/testing": "workspace:*"
  }
}
