{
  "name": "@rocky/testing",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/factory/index.d.ts",
      "default": "./dist/factory/index.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios/index.d.ts",
      "default": "./dist/scenarios/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "populate": "tsx src/populate-demo.ts"
  },
  "dependencies": {
    "@rocky/database": "workspace:*",
    "@rocky/validators": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@rocky/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
