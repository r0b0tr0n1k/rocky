{
  "name": "@rocky/execution",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@rocky/authorization": "workspace:*",
    "@rocky/database": "workspace:*",
    "drizzle-orm": "catalog:",
    "nestjs-cls": "catalog:"
  },
  "devDependencies": {
    "@rocky/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
