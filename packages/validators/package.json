{
  "name": "@rocky/validators",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "default": "./dist/enums/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/check-digit": {
      "types": "./dist/utils/check-digit.d.ts",
      "default": "./dist/utils/check-digit.js"
    },
    "./utils/type-bridge": {
      "types": "./dist/utils/type-bridge.d.ts",
      "default": "./dist/utils/type-bridge.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@rocky/database": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trpc/server": "catalog:",
    "typescript": "catalog:"
  },
  "optionalDependencies": {}
}
