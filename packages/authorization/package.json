{
  "name": "@rocky/authorization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./policies": "./src/policies/index.ts",
    "./index.js": "./src/index.ts",
    "./*": "./src/*"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@rocky/auth": "workspace:*",
    "@rocky/database": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@rocky/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}
