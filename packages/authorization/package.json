{
  "name": "@rocky/authorization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policies": {
      "types": "./dist/policies/index.d.ts",
      "default": "./dist/policies/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@rocky/auth": "workspace:*",
    "@rocky/database": "workspace:*",
    "@rocky/domains-system": "workspace:*",
    "@rocky/validators": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@rocky/testing": "workspace:*",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "@rocky/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
