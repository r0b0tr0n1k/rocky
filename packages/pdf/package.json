{
  "name": "@rocky/pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=30720' tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=16384' tsc --noEmit",
    "test": "vitest run",
    "check:pdfa": "vitest run src/engine/pdfa3.test.ts src/sign/pdf-signer.test.ts",
    "verify:pdfa": "tsx scripts/verify-pdfa.mts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@nestjs/common": "catalog:",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@rocky/database": "workspace:*",
    "@rocky/domains-animal": "workspace:*",
    "@rocky/domains-eartag": "workspace:*",
    "@rocky/domains-farm": "workspace:*",
    "@rocky/domains-health": "workspace:*",
    "@rocky/domains-inspection": "workspace:*",
    "@rocky/domains-movement": "workspace:*",
    "@rocky/domains-passport": "workspace:*",
    "@rocky/domains-shared": "workspace:*",
    "@rocky/domains-system": "workspace:*",
    "@rocky/geo": "workspace:*",
    "cbor-x": "^1.6.4",
    "drizzle-orm": "catalog:",
    "js-yaml": "^4.1.0",
    "neverthrow": "catalog:",
    "node-signpdf": "^3.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "node-forge": "^1.4.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
