{
  "name": "turborepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev",
    "dev:stop": "bash scripts/stop-dev.sh",
    "build": "turbo run build",
    "clean:src-compiled": "bash scripts/detect-src-compiled-files.sh --clean",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate:trpc": "pnpx nestjs-trpc generate --entrypoint apps/api/src/app.module.ts --output packages/trpc/src/generated && node scripts/patch-trpc-transformer.mjs",
    "generate:enums": "node scripts/regenerate-enums.mjs",
    "generate:zod": "node scripts/generate-dumb-zod.mjs",
    "generate:all": "node scripts/regenerate-enums.mjs && node scripts/generate-dumb-zod.mjs",
    "check:trpc-boundary": "node scripts/check-trpc-boundary.mjs",
    "check:web-parity": "node scripts/check-web-parity.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:md-links": "node scripts/check-md-links.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:pdfa": "pnpm --filter @rocky/pdf check:pdfa",
    "ci:checks": "pnpm generate:trpc && pnpm check:trpc-boundary && pnpm check:adrs && pnpm check:md-links && pnpm check:agents && pnpm check:pdfa && pnpm check:web-parity && pnpm test",
    "gen:api-reference": "node scripts/generate-api-reference.mjs"
  },
  "devDependencies": {
    "@rocky/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@biomejs/monorepo": "github:biomejs/biome",
    "tsx": "catalog:"
  }
}
