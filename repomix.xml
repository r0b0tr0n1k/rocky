<file path="apps/api/src/app.module.ts">
import { ConsoleLogger, Module } from '@nestjs/common';
import { AuthModule } from '@thallesp/nestjs-better-auth';
import { TRPCModule } from 'nestjs-trpc-v2';
import { auth } from './auth/auth';
import { AppContext } from './trpc/app.context';
import { LoggingMiddleware } from './trpc/middlewares/logging.middleware';
import { ProtectedMiddleware } from './trpc/middlewares/protected.middleware';
import { UserService } from './trpc/services/user.service';
import { UserRouter } from './trpc/routers/user.router';
import { NotificationRouter } from './trpc/routers/notification.router';

@Module({
  imports: [
    // Registers a global AuthGuard: every Nest route requires a session
    // unless annotated with @AllowAnonymous() or @OptionalAuth().
    AuthModule.forRoot({ auth }),

    // Generates a type-safe schema file (imported by the web app as
    // `AppRouter`) and mounts every @Router() below at /trpc.
    TRPCModule.forRoot({
      autoSchemaFile: './src/@generated',
      context: AppContext,
    }),
  ],
  providers: [
    ConsoleLogger,
    AppContext,
    LoggingMiddleware,
    ProtectedMiddleware,
    UserService,
    UserRouter,
    NotificationRouter,
  ],
})
export class AppModule {}
</file>

<file path="apps/api/src/main.ts">
import 'reflect-metadata';
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';

async function bootstrap() {
  const app = await NestFactory.create(AppModule, {
    bodyParser: false, // required so Better Auth can read the raw request body
  });

  app.enableCors({
    origin: process.env.NEXT_PUBLIC_WEB_URL ?? 'http://localhost:3001',
    credentials: true,
  });

  // nestjs-trpc-v2's TRPCModule (registered in AppModule) mounts every
  // @Router() at /trpc automatically - no manual adapter wiring needed here.

  await app.listen(process.env.PORT ?? 3000);
}
bootstrap();
