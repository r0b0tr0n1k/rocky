'use client';

import { useState } from 'react';
import { Button } from '@rocky/ui/components/button';
import { trpc } from '@/lib/trpc';
import { useSession, signIn, signOut } from '@/lib/auth-client';

export default function Home() {
  const { data: session } = useSession();
  const user = trpc.user.getUser.useQuery('1');
  const [notifications, setNotifications] = useState<string[]>([]);

  trpc.notification.onNotification.useSubscription(
    { lastEventId: null },
    {
      onData: (n) => setNotifications((prev) => [n.data.message, ...prev].slice(0, 5)),
    },
  );

  return (
    <main className="flex min-h-screen flex-col items-center justify-center gap-4">
      <h1 className="text-2xl font-semibold">
        {user.data ? `Hello, ${user.data.name}` : 'Loading...'}
      </h1>

      {session ? (
        <div className="flex items-center gap-2">
          <span>Signed in as {session.user.email}</span>
          <Button variant="outline" onClick={() => signOut()}>
            Sign out
          </Button>
        </div>
      ) : (
        <Button
          onClick={() => signIn.email({ email: 'user@email.com', password: 'password' })}
        >
          Sign in
        </Button>
      )}

      <ul className="text-sm text-foreground/70">
        {notifications.map((n, i) => (
          <li key={i}>{n}</li>
        ))}
      </ul>
    </main>
  );
}
