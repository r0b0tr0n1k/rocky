<file path="apps/api/src/trpc/middlewares/logging.middleware.ts">
import { Injectable, ConsoleLogger } from '@nestjs/common';
import { TRPCMiddleware, TRPCMiddlewareOptions } from 'nestjs-trpc-v2';
import type { Context } from 'nestjs-trpc-v2/types';

@Injectable()
export class LoggingMiddleware implements TRPCMiddleware<Context> {
  constructor(private readonly consoleLogger: ConsoleLogger) {}

  async use(opts: TRPCMiddlewareOptions) {
    const start = Date.now();
    const { next, path, type } = opts;
    const result = await next();
    const durationMs = Date.now() - start;
    const meta = { path, type, durationMs };

    result.ok
      ? this.consoleLogger.log('OK request timing', meta)
      : this.consoleLogger.error('Non-OK request timing', meta);

    return result;
  }
}
</file>

<file path="apps/api/src/trpc/middlewares/protected.middleware.ts">
import { Injectable } from '@nestjs/common';
import { TRPCMiddleware, TRPCMiddlewareOptions } from 'nestjs-trpc-v2';
import { TRPCError } from '@trpc/server';
import type { Context } from 'nestjs-trpc-v2/types';

@Injectable()
export class ProtectedMiddleware implements TRPCMiddleware<Context> {
  async use(opts: TRPCMiddlewareOptions) {
    const { ctx, next } = opts;

    if (!ctx.session) {
      throw new TRPCError({
        code: 'UNAUTHORIZED',
        message: 'You must be signed in to do this.',
      });
    }

    // Anything returned here is merged into ctx and available, fully typed,
    // as `ProtectedMiddlewareContext` from 'nestjs-trpc-v2/types' in any
    // procedure that uses @UseMiddlewares(ProtectedMiddleware).
    return next({
      ctx: {
        ...ctx,
        session: ctx.session,
        auth: { userId: ctx.session.user.id },
      },
    });
  }
}
</file>

<file path="apps/api/src/trpc/routers/notification.router.ts">
import { Injectable } from '@nestjs/common';
import { Router, Subscription, Input, Signal } from 'nestjs-trpc-v2';
import { EventEmitter, on } from 'events';
import { tracked } from '@trpc/server';
import { z } from 'zod';

const notificationSchema = z.object({
  id: z.string(),
  message: z.string(),
  timestamp: z.number(),
});

@Injectable()
@Router({ alias: 'notification' })
export class NotificationRouter {
  private readonly events = new EventEmitter();

  @Subscription({
    input: z.object({ lastEventId: z.string().nullish() }),
    output: notificationSchema,
  })
  async *onNotification(
    @Input() input: { lastEventId?: string | null },
    @Signal() signal?: AbortSignal,
  ) {
    // In a real app, replay anything the client missed while disconnected
    // using `input.lastEventId` against your persistence layer here.

    for await (const [notification] of on(this.events, 'notification', { signal })) {
      yield tracked(notification.id, notification);
    }
  }

  // Call this from any other Nest provider (e.g. after a mutation elsewhere)
  // to push a live update to every subscribed client.
  emit(notification: z.infer<typeof notificationSchema>) {
    this.events.emit('notification', notification);
  }
}
</file>

<file path="apps/api/src/trpc/routers/user.router.ts">
import { Inject, Injectable } from '@nestjs/common';
import { Router, Query, Mutation, Input, Context, UseMiddlewares } from 'nestjs-trpc-v2';
import type { ProtectedMiddlewareContext } from 'nestjs-trpc-v2/types';
import { TRPCError } from '@trpc/server';
import { z } from 'zod';
import { UserService } from '../services/user.service';
import { ProtectedMiddleware } from '../middlewares/protected.middleware';
import { LoggingMiddleware } from '../middlewares/logging.middleware';

const userSchema = z.object({
  id: z.string(),
  name: z.string(),
});

// Router-level middleware runs before any procedure-level middleware below.
@Injectable()
@Router({ alias: 'user' })
@UseMiddlewares(LoggingMiddleware)
export class UserRouter {
  constructor(@Inject(UserService) private readonly userService: UserService) {}

  @Query({ input: z.string(), output: userSchema })
  async getUser(@Input() id: string) {
    return this.userService.findById(id);
  }

  @UseMiddlewares(ProtectedMiddleware)
  @Query({ output: userSchema })
  async me(@Context() ctx: ProtectedMiddlewareContext) {
    return this.userService.findById(ctx.auth.userId);
  }

  @UseMiddlewares(ProtectedMiddleware)
  @Mutation({ input: z.object({ name: z.string() }), output: userSchema })
  async createUser(@Input() input: { name: string }) {
    try {
      return await this.userService.create(input);
    } catch (error: unknown) {
      throw new TRPCError({
        code: 'INTERNAL_SERVER_ERROR',
        message: 'Could not create user.',
        cause: error,
      });
    }
  }
}
</file>

<file path="apps/api/src/trpc/services/user.service.ts">
import { Injectable } from '@nestjs/common';

export interface User {
  id: string;
  name: string;
}

@Injectable()
export class UserService {
  // Swap this out for a real database call.
  private readonly users = new Map<string, User>([['1', { id: '1', name: 'John Doe' }]]);

  async findById(id: string): Promise<User> {
    const user = this.users.get(id);
    if (!user) {
      throw new Error('User not found');
    }
    return user;
  }

  async create(input: { name: string }): Promise<User> {
    const id = String(this.users.size + 1);
    const user = { id, ...input };
    this.users.set(id, user);
    return user;
  }
}
</file>

<file path="apps/api/src/trpc/app.context.ts">
import { Injectable } from '@nestjs/common';
import { ContextOptions, TRPCContext } from 'nestjs-trpc-v2';
import { auth } from '../auth/auth';

@Injectable()
export class AppContext implements TRPCContext {
  async create(opts: ContextOptions): Promise<Record<string, unknown>> {
    const session = await auth.api.getSession({
      headers: new Headers(opts.req.headers as Record<string, string>),
    });

    return {
      req: opts.req,
      res: opts.res,
      session,
    };
  }
}
