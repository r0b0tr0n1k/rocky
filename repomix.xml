<file path="apps/web/proxy.ts">
import { NextRequest, NextResponse } from "next/server";
import { getSessionCookie } from "better-auth/cookies";

// This is an OPTIMISTIC check only - it confirms a session cookie exists,
// it does not validate it. Always re-check `auth.api.getSession` on the
// NestJS API for any protected mutation/query.
export async function proxy(request: NextRequest) {
  const sessionCookie = getSessionCookie(request);

  if (!sessionCookie) {
    return NextResponse.redirect(new URL("/sign-in", request.url));
  }

  return NextResponse.next();
}

export const config = {
  matcher: ["/dashboard/:path*"],
};
</file>

