<file path="apps/web/lib/trpc.ts">
'use client';

import { createTRPCReact } from '@trpc/react-query';
import { httpBatchLink, httpSubscriptionLink, splitLink } from '@trpc/client';
// Type-only import across the workspace boundary - no runtime Nest code is
// bundled into the client. `nestjs-trpc-v2`'s TRPCModule writes this file
// (see `autoSchemaFile` in apps/api/src/app.module.ts) whenever the API
// starts or rebuilds, so it always mirrors the live set of routers.
import type { AppRouter } from 'api/src/@generated/server';

const API_URL = process.env.NEXT_PUBLIC_API_URL ?? 'http://localhost:3000';

export const trpc = createTRPCReact<AppRouter>();

export function getTrpcClient() {
  return trpc.createClient({
    links: [
      splitLink({
        condition: (op) => op.type === 'subscription',
        true: httpSubscriptionLink({
          url: `${API_URL}/trpc`,
        }),
        false: httpBatchLink({
          url: `${API_URL}/trpc`,
          fetch(url, options) {
            // include Better Auth session cookies on cross-origin requests
            return fetch(url, { ...options, credentials: 'include' });
          },
        }),
      }),
    ],
  });
}
</file>

