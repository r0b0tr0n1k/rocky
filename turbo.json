{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalPassThroughEnv": [
    "PG_PORT",
    "PG_HOST",
    "PG_USER",
    "PG_PASS",
    "PG_DB",
    "API_PORT",
    "WEB_PORT",
    "DOCS_PORT",
    "LANDING_PORT",
    "API_URL",
    "WEB_URL",
    "LANDING_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:trpc": {
      "dependsOn": [],
      "cache": false,
      "outputs": [
        "apps/web/lib/server.ts",
        "apps/api/src/trpc/server.ts",
        "apps/mob/trpc/server.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate:trpc"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {},
    "test": {},
    "test:e2e": {}
  }
}