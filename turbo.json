{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalPassThroughEnv": [
    "PG_PORT",
    "PG_HOST",
    "PG_USER",
    "PG_PASS",
    "PG_DB",
    "API_PORT",
    "WEB_PORT",
    "LANDING_PORT",
    "API_URL",
    "WEB_URL",
    "LANDING_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {},
    "test": {},
    "test:e2e": {}
  }
}