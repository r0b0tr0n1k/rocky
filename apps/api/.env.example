ENVIRONMENT=dev
VERSION=1.0.0
REQUEST_LOGGING=false

# Better Auth Secret - Generate a secure random string (at least 32 characters)
BETTER_AUTH_SECRET=your-super-secret-better-auth-key-change-this-in-production

PG_HOST=localhost
PG_USER=postgres
PG_PASS=postgres
PG_DB=postgres

# Ports and URLs are derived from .env.worktree at the repo root.
# API_PORT, PG_PORT, WEB_PORT are read from environment (set by with-worktree-env.sh or .env.worktree).
# BASE_SERVICE_URL, CORS_ORIGINS, TRUSTED_ORIGINS are computed from ports if not set.
#
# To override explicitly:
# PORT=8080
# BASE_SERVICE_URL="http://localhost:8080"
# CORS_ORIGINS=http://localhost:4000
# TRUSTED_ORIGINS=http://localhost:4000,mobile://

# =============================================================================
# PDF Document Signing (ADR-0082)
# =============================================================================
# Documents are sealed with a PAdES / PDF-A-3 signer. Precedence:
#   1. ROCKY_HSM_URL        -> delegate to the air-gapped HSM (production).
#   2. ROCKY_P12_PATH        -> local PAdES via a PKCS#12 cert+key (interim/dev).
#   3. (none)               -> NoOpSigner: documents egress UNSIGNED (dev only).
#
# Interim dev signer: generate a self-signed cert, bundle to a .p12, and point
# ROCKY_P12_PATH at it. The result is a REAL PAdES-LTV signature anchored on a
# test cert (external verifiers will flag an untrusted root) — fine for dev,
# not for legal EUDR proof until the qualified cert + HSM are wired.
#   ROCKY_P12_PATH=apps/api/keys/dev-signing.p12
#   ROCKY_P12_PASS=changeit
#   ROCKY_P12_SIGNATURE_LENGTH=16384
#   # Optional LTV timestamp (RFC 3161). Host MUST be in ROCKY_TSA_ALLOWED_HOSTS.
#   ROCKY_TSA_URL=https://freetsa.org/tsr
#   ROCKY_TSA_ALLOWED_HOSTS=freetsa.org
#
# Production HSM:
#   ROCKY_HSM_URL=https://hsm.internal.example/SignPDF
#   ROCKY_HSM_TOKEN=service-token
#   ROCKY_HSM_TRUSTED_HOSTS=hsm.internal.example

# ── Offline-verifiable signed-QR credential key (ADR-0084) ──────────────────
# Separate Ed25519 keypair from the PAdES RSA seal (same trust root, but the
# offline RN verifier runs Ed25519 with no native deps). Resolution order:
#   1. ROCKY_CRED_KEY (base64 Ed25519 sk) + ROCKY_CRED_PUBKEY (base64 pk) -> prod
#   2. ROCKY_CRED_KEY_PATH -> JSON { privateKey, publicKey, kid } (interim/dev)
# If neither is set, signed-QR credentials are disabled (PAdES path unaffected).
#   ROCKY_CRED_KEY_PATH=apps/api/keys/dev-cred-ed25519.json
#   ROCKY_CRED_ISS=rocky:cattle
#   # Production:
#   ROCKY_CRED_KEY=<base64-ed25519-private-key>
#   ROCKY_CRED_PUBKEY=<base64-ed25519-public-key>
#   ROCKY_CRED_KID=rocky-prod
