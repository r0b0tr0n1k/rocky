    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "next": "catalog:",
    "next-themes": "catalog:",
    "nextra": "catalog:",
    "nextra-theme-docs": "catalog:",
    "postcss": "^8.5.14",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@rocky/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "pagefind": "^1.5.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  }
