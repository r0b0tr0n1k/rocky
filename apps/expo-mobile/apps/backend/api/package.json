{
  "name": "@yourcompany/api",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./types": "./src/@generated/server.ts",
    "./auth": "./src/auth/auth.ts"
  },
  "scripts": {
    "dev": "node --import 'amaro/strip' --no-warnings --env-file=.env --watch src/main.ts | pino-pretty",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import 'amaro/strip' --no-warnings src/main.ts",
    "lint:check": "biome lint ./src",
    "lint": "biome lint --fix ./src",
    "format:check": "biome format ./src",
    "format": "biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prasici/database": "workspace:*",
    "@prasici/validators": "workspace:*",
    "@trpc/server": "^11.18.0",
    "@yourcompany/backend-core": "workspace:*",
    "better-auth": "catalog:",
    "nestjs-trpc-v2": "^1.4.1",
    "pg": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@yourcompany/configs": "workspace:*",
    "amaro": "catalog:",
    "pino-pretty": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:"
  }
}
