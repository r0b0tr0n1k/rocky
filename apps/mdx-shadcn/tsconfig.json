{
  "extends": "@rocky/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next",
      },
    ],
    "strictNullChecks": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "skipLibCheck": true,
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".velite",
  ],
  "exclude": [
    "node_modules",
    "*.config.ts",
    "*.config.mjs",
    "*.config.js"
  ],
}