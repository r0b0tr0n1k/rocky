# API Configuration
# Default uses localhost — for physical device testing, replace with your computer's IP.
# Example: http://192.168.1.100:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Note: Expo bakes EXPO_PUBLIC_* vars at build time, so .env.worktree cannot override these.
# Update this file directly when using non-default ports.

# Cloudflare Access service token (DEV/TEST ONLY) — lets the app pass the Access challenge
# against a Cloudflare-fronted backend without an interactive login.
# Generate in Cloudflare Zero Trust -> Access -> Service Tokens. Leave blank in production.
EXPO_PUBLIC_CF_ACCESS_CLIENT_ID=
EXPO_PUBLIC_CF_ACCESS_CLIENT_SECRET=
