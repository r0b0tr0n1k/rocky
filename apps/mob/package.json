{
  "name": "@rocky/mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "imports": {
    "#/*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 expo start -c",
    "web": "NODE_OPTIONS=--max-old-space-size=4096 expo start -c --web",
    "android": "NODE_OPTIONS=--max-old-space-size=4096 expo start -c --android",
    "ios": "NODE_OPTIONS=--max-old-space-size=4096 expo start -c --ios",
    "build:android": "npx expo prebuild -p android --clean && cd android && ./gradlew assembleRelease",
    "build:android:debug": "npx expo prebuild -p android --clean && cd android && ./gradlew assembleDebug",
    "clean": "rm -rf .expo node_modules",
    "build:cloud:android": "eas build -p android --profile production",
    "build:cloud:ios": "eas build -p ios --profile production",
    "build:cloud:preview": "eas build --profile preview",
    "submit:production": "eas submit --profile production"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@react-native-community/netinfo": "12.0.1",
