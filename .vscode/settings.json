{
  "workbench.colorCustomizations": {
    "activityBar.background": "#5F0B08",
    "titleBar.activeBackground": "#85100B",
    "titleBar.inactiveBackground": "#85100B",
    "titleBar.activeForeground": "#FFFCFB",
    "statusBar.background": "#85100B",
    "statusBar.foreground": "#FFFCFB"
  },
  // Biome as default formatter for all supported file types
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  // Biome code actions on save
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports": "explicit"
  },
  // TypeScript/JavaScript import handling (Biome manages this)
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  // Language-specific formatter settings
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // Biome extension settings
  "biome.requireConfigFile": true,
  "biome.lsp.bin": "bunx",
  // Disable other formatters/linters (Biome handles everything)
  "eslint.validate": [],
  // File-specific settings
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "yaml.schemas": {
    ".pi-lens/empty-schema.json": [".pi-lens/architect.yaml"]
  },
  // Panopticon JSON schema validation
  "json.schemas": [
    {
      "fileMatch": ["registry.json"],
      "url": "./src/laws/registry.schema.json"
    }
  ],
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx"
  }
}
